@page "/Solicitudes/{UserID}/{ClienteID:int}"

@rendermode InteractiveServer
@attribute [StreamRendering]

@inject SolicitudViajesService solicitudesViajesService
@inject ClientesServices clientesService
@inject AuthenticationStateProvider AuthStateProvider

@attribute [Authorize(Roles = "cliente, admin")]

<PageTitle>Registro de Solicitudes</PageTitle>
<div class="container mb-4">
    <div class="card">
        <div class="row p-2 m-2">
            <div class="col">
                <div class="text-left">
                    <h2 class="text-black"><i class="bi bi-people"></i>Mis Solicitudes</h2>
                </div>
            </div>
            <div class="col text-end">
                <AuthorizeView Roles="admin">
                    <Authorized>
                        <a href="/Clientes/Index" class="btn btn-secondary"><i class="bi bi-plus-lg"></i>Volver</a>
                    </Authorized>
                </AuthorizeView>
                <AuthorizeView Roles="cliente">
                    <Authorized>
                        <a href="/" class="btn btn-secondary"><i class="bi bi-plus-lg"></i>Volver</a>
                    </Authorized>
                </AuthorizeView>
                <a href="/Solicitudes/Create/@UserID/@ClienteID" class="btn btn-secondary"><i class="bi bi-plus-lg"></i>Crear</a>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-4">
                    <div class="input-group" style="width: 300px">
                        <div class="form-floating">
                            <InputSelect class="form-select" id="floatingSelect" aria-label="Floating label select example" @bind-Value="@valorEnFiltro">
                                <option value="" selected disabled>--- Selecciona ---</option>
                                <option value="idsolicitud">ID</option>
                                <option value="cliente">Cliente</option>
                                <option value="fecha">Fecha</option>
                                <option value="estado">Estado</option>
                                <option value="estadovencimiento">Estado vencimiento</option>
                            </InputSelect>
                            <label for="floatingSelect"><strong>Filtrar en base a...</strong></label>
                        </div>
						@*btn restablecer*@
                        <button type="button" class="btn btn-secondary bi bi-arrow-counterclockwise" @onclick="() => Restablecer()">Limpiar</button>
                    </div>
                </div>

				@*Btn Buscar*@
                <div class="col">
                    <div class="input-group" style="width: 500px">
						@*textbox buscar*@
                        <div class="form-floating d-flex align-items-center">
                            <InputText @bind-Value="@criterioBusqueda" class="form-control" placeholder="" id="floatingSearch" />
                            <label for="floatingSearch">Buscar</label>
                        </div>
                        <button @onclick="Buscar" class="btn btn-secondary bi bi-search" type="button">Buscar</button>
                    </div>
                </div>
            </div>

            @if (valorEnFiltro == "fecha")
            {
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label for="fechaInicial" class="form-label">Fecha inicial *</label>
                        <InputDate @bind-Value="Desde" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label for="fechaFinal" class="form-label">Fecha final *</label>
                        <InputDate @bind-Value="Hasta" class="form-control" />
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(MensajeError))
            {
                <div class="alert alert-danger" role="alert">
                    @MensajeError
                </div>
            }

            @if (ListaSolicitudes == null)
            {
                <div class="d-flex align-items-center justify-content-center">
                    <em role="status" class="me-2">Cargando...</em>
                    <div class="spinner-border" aria-hidden="true"></div>
                </div>
            }
            else
            {
                <table class="table table-sm table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <AuthorizeView Roles="admin">
                                <Authorized>
                                    <th>Cliente</th>
                                </Authorized>
                            </AuthorizeView>
                            <th>Asunto</th>
                            <th>Adultos</th>
                            <th>Niños</th>
                            <th>Fecha Estipulada</th>
                            <th>Estado</th>
                            <th>Estado Vencimiento</th>
                            <th>Monto</th>
                            <th>Nota</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var solicitud in ListaSolicitudes)
                        {
                            try
                            {
                                if (solicitud.ClienteId == Cliente.ClienteId || userAutenticado.IsInRole("admin"))
                                {
                                    <tr>
                                        <td>@solicitud.SolicitudViajeId</td>
                                        <AuthorizeView Roles="admin">
                                            <Authorized>
                                                <td>@solicitud.Cliente.Nombre</td>
                                            </Authorized>
                                        </AuthorizeView>
                                        <td>@solicitud.Asunto</td>
                                        <td>@solicitud.CantAdultos</td>
                                        <td>@solicitud.CantNinos</td>
                                        <td>@solicitud.FechaEstipulada.ToString("dd/MMM/yyyy")</td>
                                        <td>
                                            @switch (solicitud.EstadoId)
                                            {
                                                case 1:
                                                    <span class="badge badge-pill bg-success">Aprobada</span>
                                                    break;
                                                case 2:
                                                    <span class="badge badge-pill bg-warning text-dark">En espera</span>
                                                    break;
                                                case 3:
                                                    <span class="badge badge-pill bg-danger">Rechazada</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-pill bg-secondary">Desconocido</span>
                                                    break;
                                            }
                                        </td>
                                        <td>
                                            @switch (solicitud.EstadoVencimientoId)
                                            {
                                                case 1:
                                                    <span class="badge badge-pill bg-primary">Vigente</span>
                                                    break;
                                                case 2:
                                                    <span class="badge badge-pill bg-warning text-dark">Vencida</span>
                                                    break;
                                                default:
                                                    <span class="badge badge-pill bg-secondary">Desconocido</span>
                                                    break;
                                            }
                                        </td>
                                        <td>RD$@solicitud.Precio.ToString("N2")</td>
                                        <td>@solicitud.Nota</td>
                                        <td>
                                            <div class="dropdown">
                                                <a style="cursor: pointer;" class="dropdown-toggle" data-toggle="dropdown">Desplegar</a>
                                                <div class="dropdown-menu">
                                                    <a href="/Solicitudes/View/@UserID/@solicitud.SolicitudViajeId-@ClienteID" class="dropdown-item">Detalles</a>
                                                    <a href="/Solicitudes/Edit/@UserID/@solicitud.SolicitudViajeId-@ClienteID" class="dropdown-item">Editar</a>
                                                    <a href="/Solicitudes/Delete/@UserID/@solicitud.SolicitudViajeId-@ClienteID" class="dropdown-item">Eliminar</a>

                                                    <AuthorizeView Roles="admin">
                                                        <Authorized>
                                                            <div class="dropdown-divider"></div>
                                                            <div class="dropdown-header">Cambiar estado</div>
                                                            <div class="dropdown-divider"></div>
                                                            <button @onclick="(() => CambiarEstado(solicitud.SolicitudViajeId,1))" class="dropdown-item">Aprovada</button>
                                                            <button @onclick="(() => CambiarEstado(solicitud.SolicitudViajeId,2))" class="dropdown-item">En espera</button>
                                                            <button @onclick="(() => CambiarEstado(solicitud.SolicitudViajeId,3))" class="dropdown-item">Rechazada</button>
                                                        </Authorized>
                                                    </AuthorizeView>
                                                </div>
                                            </div>

                                        </td>
                                    </tr>
                                    SolicitudesPorCliente++;
                                }
                            }
                            catch (Exception e)
                            {
                                Console.WriteLine($"Error en el index de solicitudes: {e.Message}");
                            }
                        }
                    </tbody>
                    <caption>Cant. de Solicitudes: @SolicitudesPorCliente</caption>
                </table>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string UserID { get; set; }
    [Parameter] public int ClienteID { get; set; }
    public Clientes Cliente { get; set; } = new();
    public int SolicitudesPorCliente = 0;
    public List<SolicitudViajes>? ListaSolicitudes { get; set; }
    private System.Security.Claims.ClaimsPrincipal? userAutenticado;
    public string criterioBusqueda { get; set; } = string.Empty;
    public string valorEnFiltro { get; set; } = string.Empty;
    public DateTime? Desde { get; set; } = null;
    public DateTime? Hasta { get; set; } = null;
    public string MensajeError { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        userAutenticado = authState.User;
        Cliente = await clientesService.BuscarPorUsuarioId(UserID);
        ListaSolicitudes = await solicitudesViajesService.Listar(x => true);
    }

    public async Task CambiarEstado(int solicitudId, int nuevoEstadoId)
    {
        var solicitud = await solicitudesViajesService.Buscar(solicitudId);

        if (solicitud == null)
        {
            return;
        }

        solicitud.EstadoId = nuevoEstadoId;
        var resultado = await solicitudesViajesService.Guardar(solicitud);

        if (!resultado)
        {
            return;
        }

        ListaSolicitudes = await solicitudesViajesService.Listar(x => true);
        StateHasChanged();
    }

    public async Task Buscar()
    {
        MensajeError = string.Empty;
        if (string.IsNullOrEmpty(valorEnFiltro))
        {
            MensajeError = "Debe seleccionar una opcion en el filtro para buscar";
            return;
        }

        criterioBusqueda.Trim().ToLower();

        switch (valorEnFiltro)
        {
            case "idsolicitud":
                if (string.IsNullOrEmpty(criterioBusqueda))
                    return;
                if (!criterioBusqueda.All(char.IsDigit))
                {
                    MensajeError = "Debe escribir un ID valido";
                    return;
                }
                ListaSolicitudes = await solicitudesViajesService.Listar(lt => lt.SolicitudViajeId.ToString().Contains(criterioBusqueda));
                break;

            case "cliente":
                if (string.IsNullOrEmpty(criterioBusqueda))
                {
                    MensajeError = "Debe escribir un nombre valido";
                    return;
                }
                ListaSolicitudes = await solicitudesViajesService.Listar(lt => lt.Cliente.Nombre.Trim().ToLower()
                                                            .Contains(criterioBusqueda));
                break;

            case "estado":
                if (!criterioBusqueda.All(char.IsDigit))
                {
                    MensajeError = "Debe escribir un ID Estado valido";
                    return;
                }
                ListaSolicitudes = await solicitudesViajesService.Listar(lt => lt.EstadoId.ToString().Trim().ToLower()
                                                            .Contains(criterioBusqueda));
                break;

            case "estadovencimiento":
                if (!criterioBusqueda.All(char.IsDigit))
                {
                    MensajeError = "Debe escribir un ID Estado vencimiento valido";
                    return;
                }
                ListaSolicitudes = await solicitudesViajesService.Listar(lt => lt.EstadoVencimientoId.ToString().Trim().ToLower()
                                                            .Contains(criterioBusqueda));
                break;

            case "fecha":
                if (Desde == null || Hasta == null)
                {
                    MensajeError = "Ambas campos de fecha deben ser llenados";
                    return;
                }
                if (Desde > Hasta)
                {
                    MensajeError = "La fecha inicial no puede ser mayor a la final";
                    return;
                }
                ListaSolicitudes = await solicitudesViajesService.Listar(lt => lt.FechaEstipulada >= Desde && lt.FechaEstipulada <= Hasta);
                break;
        }
    }

    public async Task Restablecer()
    {
        MensajeError = string.Empty;
        criterioBusqueda = string.Empty;
        valorEnFiltro = string.Empty;
        Desde = null;
        Hasta = null;
        ListaSolicitudes = await solicitudesViajesService.Listar(x => true);
    }
}

