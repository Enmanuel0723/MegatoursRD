@using Microsoft.AspNetCore.Identity
@implements IDisposable

@inject NavigationManager NavigationManager
@inject ClientesServices clientesService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthStateProvider


<div class="container-fluid position-relative nav-bar p-0">
    <div class="container-lg position-relative p-0 px-lg-3" style="z-index: 9;">
        <nav class="navbar navbar-expand-lg bg-light navbar-light shadow-lg py-3 py-lg-0 pl-3 pl-lg-5">
            <a href="" class="navbar-brand">
                <h1 class="text-primary"><span class="text-dark">MEGATOURS</span>RD</h1>
            </a>
            <button type="button" class="navbar-toggler" data-toggle="collapse" data-target="#navbarCollapse">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-between px-3" id="navbarCollapse">
                <div class="navbar-nav ml-auto py-0">
                    <a href="/" class="nav-item nav-link active">Home</a>
                    <AuthorizeView Roles="admin">
                        <Authorized>
                            <a href="Administradores/Index" class="nav-item nav-link">Administradores</a>
                            <a href="Clientes/Index" class="nav-item nav-link">Clientes</a>
                        </Authorized>
                    </AuthorizeView>
                    <AuthorizeView Roles="cliente">
                        <Authorized>
                            <a href="@($"Solicitudes/{Cliente.AplicationUserId}/{Cliente.ClienteId}")" class="nav-item nav-link">Mis Solicitudes</a>
                            <a href="@($"Viajes/Index/{Cliente.AplicationUserId}/{Cliente.ClienteId}")" class="nav-item nav-link">Mis Viajes</a>
                        </Authorized>
                    </AuthorizeView>
                    <a href="/About" class="nav-item nav-link">About</a>
                </div>
            </div>
        </nav>
    </div>
</div>


@code {
    private string? currentUrl;
    public Clientes Cliente { get; set; } = new();
    public ApplicationUser? User { get; set; }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var userAutenticado = authState.User;
            User = await UserManager.FindByNameAsync(userAutenticado.Identity.Name);
            Cliente = await clientesService.BuscarPorUsuarioId(User.Id);
        }
        catch (Exception e)
        {
            Console.WriteLine($"Error en el NavMenu: Como no hay un usuario logeado entonces --> {e.Message}");
        }
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        StateHasChanged();
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
    }
}

