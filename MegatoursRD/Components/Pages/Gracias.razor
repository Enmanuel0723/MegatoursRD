@page "/Gracias"

@attribute [Authorize]

<PageTitle>Gracias por su compra</PageTitle>

<div class="d-flex justify-content-center align-items-center flex-column text-center" style="min-height: 80vh;">
    <img src="/img/compra-exitosa.png" alt="Gracias por su compra" width="256" height="256" class="mb-4" />
    <h1 class="text-success fw-bold">¡Gracias por su compra!</h1>
    <p class="text-muted fs-5">Tu transacción fue exitosa. Recibirás un correo con los detalles de tu compra.</p>
    <a href="/" class="btn btn-outline-primary mt-3">Volver al inicio</a>
</div>
