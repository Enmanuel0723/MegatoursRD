@page "/Destinos/Index"

@rendermode InteractiveServer

@attribute [StreamRendering]
@attribute [Authorize(Roles = "admin")]

@inject DestinosService destinosService
@inject IJSRuntime JS

<PageTitle>Registro de Destinos</PageTitle>
<div class="container mb-4">
    <div class="card">
        <div class="row p-2 m-2">
            <div class="col">
                <div class="text-left">
                    <h2 class="text-black"><i class="bi bi-people"></i>Destinos</h2>
                </div>
            </div>
            <div class="col text-end">
                <a href="/" class="btn btn-secondary"><i class="bi bi-plus-lg"></i>Volver</a>
                <button class="btn btn-secondary" @onclick="AbrirModal">Crear</button>
            </div>
        </div>
    </div>
</div>

<div class="container">
    <div class="card">
        <div class="card-body">
            <div class="row mb-4">
                <div class="col-4">
                    <div class="input-group" style="width: 300px">
                        <div class="form-floating">
                            <InputSelect class="form-select" id="floatingSelect" aria-label="Floating label select example" @bind-Value="@valorEnFiltro">
                                <option value="" selected disabled>--- Selecciona ---</option>
                                <option value="iddestino">ID Destino</option>
                                <option value="destino">Destino</option>
                            </InputSelect>
                            <label for="floatingSelect"><strong>Filtrar en base a...</strong></label>
                        </div>
						@*btn restablecer*@
                        <button type="button" class="btn btn-secondary bi bi-arrow-counterclockwise" @onclick="() => Restablecer()">Limpiar</button>
                    </div>
                </div>

				@*Btn Buscar*@
                <div class="col">
                    <div class="input-group" style="width: 500px">
						@*textbox buscar*@
                        <div class="form-floating d-flex align-items-center">
                            <InputText @bind-Value="@criterioBusqueda" class="form-control" placeholder="" id="floatingSearch" />
                            <label for="floatingSearch">Buscar</label>
                        </div>
                        <button @onclick="Buscar" class="btn btn-secondary bi bi-search" type="button">Buscar</button>
                    </div>
                </div>
            </div>

            @if (valorEnFiltro == "fecha")
            {
                <div class="row mb-4">
                    <div class="col-md-6">
                        <label for="fechaInicial" class="form-label">Fecha inicial *</label>
                        <InputDate @bind-Value="Desde" class="form-control" />
                    </div>
                    <div class="col-md-6">
                        <label for="fechaFinal" class="form-label">Fecha final *</label>
                        <InputDate @bind-Value="Hasta" class="form-control" />
                    </div>
                </div>
            }

            @if (!string.IsNullOrEmpty(MensajeError))
            {
                <div class="alert alert-danger" role="alert">
                    @MensajeError
                </div>
            }

            @if (ListaDestinos == null)
            {
                <div class="d-flex align-items-center justify-content-center">
                    <em role="status" class="me-2">Cargando...</em>
                    <div class="spinner-border" aria-hidden="true"></div>
                </div>
            }
            else
            {
                <table class="table table-sm table-striped table-hover">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Foto</th>
                            <th>Ciudad</th>
                            <th>Descripción</th>
                            <th>Cupos</th>
                            <th>Fecha estipulada</th>
                            <th>Precio de entrada</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var destino in ListaDestinos)
                        {
                            <tr>
                                <td>@destino.DestinoId</td>
                                <td>
                                    @if (!string.IsNullOrEmpty(destino.ImagenUrl))
                                    {
                                        <img src="@destino.ImagenUrl" style="width: 100px; height: auto;" />
                                    }
                                    else
                                    {
                                        <h5><span class="badge text-bg-secondary">No disponible</span></h5>
                                    }
                                </td>
                                <td>@destino.Ciudad</td>
                                <td>
                                    @if (destino.Descripcion.Length > 50)
                                    {
                                        @(destino.Descripcion.Substring(0, 50) + "...")
                                    }
                                    else
                                    {
                                        @destino.Descripcion
                                    }
                                </td>
                                <td>@destino.Cupos</td>
                                <td>@destino.FechaEstipulada.ToString("dd/MMM/yyyy")</td>
                                <td>RD$@destino.PrecioEntrada.ToString("N2")</td>
                                <td>
                                    <div class="dropdown">
                                        <a style="cursor: pointer;" class="dropdown-toggle" data-toggle="dropdown">Desplegar</a>
                                        <div class="dropdown-menu">
                                            <button type="button" @onclick="(() => AbrirModalEditar(destino.DestinoId))" class="dropdown-item">Editar</button>
                                            <button type="button" @onclick="(() => AbrirModalEliminar(destino.DestinoId))" class="dropdown-item">Eliminar</button>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                    <caption>Cant. de destinos: @ListaDestinos.Count</caption>
                </table>
            }
        </div>
    </div>


    @*CREATE*@
    <div class="modal fade" id="modalConfirmar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-black">Crear destino</h5>
                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <EditForm Model="Destino" OnValidSubmit="Guardar">
                    <div class="modal-body">
                        <DataAnnotationsValidator />
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label"><strong>Ciudad *</strong></label>
                                <InputText required @bind-Value="Destino.Ciudad" placeholder="Ciudad" class="form-control"></InputText>
                            </div>
                            <div class="col">
                                <label class="form-label"><strong>Cupos *</strong></label>
                                <InputNumber required @bind-Value="Destino.Cupos" class="form-control"></InputNumber>
                            </div>
                            <div class="col">
                                <label class="form-label"><strong>Precio entrada *</strong></label>
                                <InputNumber required @bind-Value="Destino.PrecioEntrada" class="form-control"></InputNumber>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label"><strong>Fecha estipulada *</strong></label>
                                <InputDate required @bind-Value="Destino.FechaEstipulada" class="form-control"></InputDate>
                            </div>
                            <div class="col">
                                <label class="form-label"><strong>Descripción *</strong></label>
                                <InputTextArea required @bind-Value="Destino.Descripcion" placeholder="Descripción" maxlength="144" class="form-control"></InputTextArea>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label"><strong>Imagen *</strong></label>
                                <InputFile class="file-input" OnChange="SubirImagen" accept="image/*" />
                            </div>
                            @if (!string.IsNullOrEmpty(Destino.ImagenUrl))
                            {
                                <div class="col">
                                    <img src="@Destino.ImagenUrl" style="max-width: 150px;" />
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(MensajeErrorCreate))
                        {
                            <div class="alert alert-danger" role="alert">
                                @MensajeErrorCreate
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Mensaje))
                        {
                            <div class="alert alert-success" role="alert">
                                @Mensaje
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Crear</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    @*EDITAR*@
    <div class="modal fade" id="modalEditar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-black">Editar destino</h5>
                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <EditForm Model="Destino" OnValidSubmit="Editar">
                    <div class="modal-body">
                        <DataAnnotationsValidator />
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label"><strong>Ciudad *</strong></label>
                                <InputText required @bind-Value="Destino.Ciudad" placeholder="Ciudad" class="form-control"></InputText>
                            </div>
                            <div class="col">
                                <label class="form-label"><strong>Cupos *</strong></label>
                                <InputNumber required @bind-Value="Destino.Cupos" class="form-control"></InputNumber>
                            </div>
                            <div class="col">
                                <label class="form-label"><strong>Precio entrada *</strong></label>
                                <InputNumber required @bind-Value="Destino.PrecioEntrada" class="form-control"></InputNumber>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label"><strong>Fecha estipulada *</strong></label>
                                <InputDate required @bind-Value="Destino.FechaEstipulada" class="form-control"></InputDate>
                            </div>
                            <div class="col">
                                <label class="form-label"><strong>Descripción *</strong></label>
                                <InputTextArea required @bind-Value="Destino.Descripcion" placeholder="Descripción" maxlength="144" class="form-control"></InputTextArea>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col">
                                <label class="form-label"><strong>Imagen *</strong></label>
                                <InputFile class="file-input" OnChange="SubirImagen" accept="image/*" />
                            </div>
                            @if (!string.IsNullOrEmpty(Destino.ImagenUrl))
                            {
                                <div class="col">
                                    <img src="@Destino.ImagenUrl" style="max-width: 150px;" />
                                </div>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(MensajeErrorEdit))
                        {
                            <div class="alert alert-danger" role="alert">
                                @MensajeErrorEdit
                            </div>
                        }
                        @if (!string.IsNullOrEmpty(Mensaje))
                        {
                            <div class="alert alert-success" role="alert">
                                @Mensaje
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                        <button type="submit" class="btn btn-primary">Editar</button>
                    </div>
                </EditForm>
            </div>
        </div>
    </div>

    @*ELIMINAR*@
    <div class="modal fade" id="modalEliminar" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title fw-bold text-black">Eliminar destino</h5>
                    <button type="button" class="btn-close" data-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body">
                    <p>¿Está seguro de que quiere eliminar este destino?</p>
                    @if (!string.IsNullOrEmpty(Mensaje))
                    {
                        <div class="alert alert-success" role="alert">
                            @Mensaje
                        </div>
                    }
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancelar</button>
                    <button @onclick="Eliminar" class="btn btn-danger">Eliminar</button>
                </div>
            </div>
        </div>
    </div>

</div>

@code {
    public List<Destinos>? ListaDestinos { get; set; }
    public Destinos Destino { get; set; } = new();
    public string criterioBusqueda { get; set; } = string.Empty;
    public string valorEnFiltro { get; set; } = string.Empty;
    public DateTime? Desde { get; set; } = null;
    public DateTime? Hasta { get; set; } = null;
    public string MensajeError { get; set; } = string.Empty;
    public string MensajeErrorCreate { get; set; } = string.Empty;
    public string MensajeErrorEdit { get; set; } = string.Empty;
    public string MensajeErrorDelete { get; set; } = string.Empty;
    public string Mensaje { get; set; } = "";

    protected override async Task OnInitializedAsync()
    {
        await Task.Delay(500);
        ListaDestinos = await destinosService.Listar(x => true);
    }

    private async Task AbrirModal()
    {
        Mensaje = "";
        Destino = new();
        await JS.InvokeVoidAsync("bootstrapInterop.abrirModal", "#modalConfirmar");
    }
    private async Task AbrirModalEditar(int id)
    {
        Mensaje = "";
        await JS.InvokeVoidAsync("bootstrapInterop.abrirModal", "#modalEditar");
        Destino = await destinosService.Buscar(id);
    }
    private async Task AbrirModalEliminar(int id)
    {
        Mensaje = "";
        await JS.InvokeVoidAsync("bootstrapInterop.abrirModal", "#modalEliminar");
        Destino = await destinosService.Buscar(id);
    }

    // INDEX
    public async Task Buscar()
    {
        MensajeError = "";
        if (string.IsNullOrEmpty(valorEnFiltro)) { return; }

        criterioBusqueda.Trim().ToLower();

        switch (valorEnFiltro)
        {
            case "iddestino":
                if (string.IsNullOrEmpty(criterioBusqueda) || !criterioBusqueda.All(char.IsDigit))
                {
                    MensajeError = "Debe escribir un ID valido";
                    return;
                }
                ListaDestinos = await destinosService.Listar(lt => lt.DestinoId.ToString().Contains(criterioBusqueda));
                break;

            case "destino":
                if (string.IsNullOrEmpty(criterioBusqueda))
                {
                    MensajeError = "Debe escribir una ciudad valido";
                    return;
                }
                ListaDestinos = await destinosService.Listar(lt => lt.Ciudad.Trim().ToLower()
                                                            .Contains(criterioBusqueda));
                break;

            case "fecha":
                if (Desde == null || Hasta == null)
                {
                    MensajeError = "Ambas campos de fecha deben ser llenados";
                    return;
                }
                if (Desde > Hasta)
                {
                    MensajeError = "La fecha inicial no puede ser mayor a la final";
                    return;
                }
                ListaDestinos = await destinosService.Listar(lt => lt.FechaEstipulada >= Desde && lt.FechaEstipulada <= Hasta);
                break;
        }
    }
    public async Task Restablecer()
    {
        MensajeError = string.Empty;
        criterioBusqueda = string.Empty;
        valorEnFiltro = string.Empty;
        Desde = null;
        Hasta = null;
        ListaDestinos = await destinosService.Listar(x => true);
    }


    // CREATE
    public async Task Guardar()
    {
        Mensaje = "";
        MensajeErrorCreate = "";
        if (Destino.FechaEstipulada <= DateTime.Now)
        {
            MensajeErrorCreate = "La fecha no puede ser menor o igual a la actual";
            return;
        }
        await destinosService.Guardar(Destino);
        StateHasChanged();
        Mensaje = "Se creo el destino, pulse esc para cerrar esta ventana";
        ListaDestinos = await destinosService.Listar(x => true);
    }
    public async Task SubirImagen(InputFileChangeEventArgs e)
    {
        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 2 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            Destino.ImagenUrl = $"data:{e.File.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
        }
        catch (Exception ex)
        {
            MensajeErrorCreate = $"Error al subir la imagen: {ex.Message}";
        }
    }


    // EDITAR
    public async Task Editar()
    {
        Mensaje = "";
        MensajeErrorEdit = "";
        var destino = await destinosService.Buscar(Destino.DestinoId);
        if (destino == null)
        {
            MensajeErrorEdit = "El destino no existe";
            return;
        }
        if (Destino.FechaEstipulada <= DateTime.Now)
        {
            MensajeErrorEdit = "La fecha no puede ser menor o igual a la actual";
            return;
        }
        await destinosService.Guardar(Destino);
        StateHasChanged();
        Mensaje = "Se edito el destino, pulse esc para cerrar esta ventana";
        ListaDestinos = await destinosService.Listar(x => true);
    }


    // ELIMINAR
    public async Task Eliminar()
    {
        Mensaje = "";
        MensajeErrorDelete = "";
        var destino = await destinosService.Buscar(Destino.DestinoId);
        if (destino == null)
        {
            MensajeErrorDelete = "El destino no existe";
            return;
        }
        await destinosService.Eliminar(destino.DestinoId);
        StateHasChanged();
        Mensaje = "Se elimino el destino, pulse esc para cerrar esta ventana";
        ListaDestinos = await destinosService.Listar(x => true);
    }
}

