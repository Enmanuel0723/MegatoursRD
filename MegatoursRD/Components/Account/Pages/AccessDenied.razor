@page "/Account/AccessDenied"

<PageTitle>Acceso denegado</PageTitle>

<div style="display: grid; grid-template-columns: repeat(3, 1fr); grid-template-rows: repeat(3, 1fr); height: 100vh;">
    <div style="grid-column: 2; grid-row: 2; display: flex; flex-direction: column; align-items: center;">
        <header class="text-center">
            <h1 class="text-danger">Acceso denegado</h1>
            <p class="text-danger">No tienes acceso a este recurso.</p>
        </header>
    </div>
</div>